{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "destination": "/api/v1/$1",
      "source": "/v1/(.*)"
    },
    {
      "destination": "/privacy.html",
      "source": "/privacy"
    },
    {
      "destination": "/privacy.html",
      "source": "/privacy-policy"
    },
    {
      "destination": "/index.html",
      "source": "/((?!api/|\\.env|\\.git).*)"
    }
  ],
  "version": 2
}
