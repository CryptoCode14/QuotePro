{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "destination": "/api/v1/$1",
      "source": "/v1/(.*)"
    },
    {
      "destination": "/api/index.js",
      "source": "/api/(calculator|estimates)(/.*)?"
    },
    {
      "destination": "/index.html",
      "source": "/((?!api/).*)"
    }
  ],
  "version": 2
}